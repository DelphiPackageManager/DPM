unit DPM.Core.Project.CopyLocalTargets;

interface

uses
  DPM.Core.Logging;

const
  //File name written into the cache root and imported by DPM-managed dprojs as
  //$(DPMCache)\DPM.CopyLocal.targets - see TProjectEditor.EnsureCopyLocalImport.
  cCopyLocalTargetsFileName = 'DPM.CopyLocal.targets';

  //The exact <Import Project=".."> value TProjectEditor.EnsureCopyLocalImport writes. Shared so
  //that TBuildHookValidator, which has to recognise DPM's own import as legitimate rather than
  //treat it as an author supplied target injection, cannot drift from what the editor emits.
  cCopyLocalImportProject = '$(DPMCache)\' + cCopyLocalTargetsFileName;

  //Bump when the targets content below changes so EnsureCopyLocalTargets rewrites stale copies.
  cCopyLocalTargetsVersion = '3';

//Returns the full text of DPM.CopyLocal.targets (CRLF line endings, version-marked). dpmExePath is the
//full path of the dpm.exe the target runs - '' when it isn't known.
function GetCopyLocalTargetsContent(const dpmExePath : string) : string;

//Writes DPM.CopyLocal.targets into the cache root unless it already says exactly that. Idempotent and
//safe to call on every restore/install. The cache is per machine, so this file is where the machine's
//dpm.exe is recorded - projects record nothing, and so don't differ between machines. With dpmExePath ''
//(not known - the IDE plugin, with no dpm.exe beside it) a file of this version is left as it is, as the
//path it holds is the better guess. Failures are logged as warnings, never raised - a missing targets
//file simply means copy-local does nothing (the dproj import is Exists()-guarded).
procedure EnsureCopyLocalTargets(const cacheRoot : string; const dpmExePath : string; const logger : ILogger);

implementation

uses
  System.SysUtils,
  System.IOUtils,
  DPM.Core.Diagnostics;

const
  //The Exec Command must stay on a single line - MSBuild turns embedded newlines into separate
  //batch lines, which breaks the command. dpm is only ever run by a full path: $(DPMExe) when that is
  //given (msbuild /p:DPMExe=..) and exists, else the dpm.exe the last restore on this machine recorded
  //here. Never a bare 'dpm' - Exec runs its command through cmd.exe in the project's folder, so that
  //would be looked for there and on PATH. When neither exists, the target warns and does nothing.
  cVersionMarker = '<!-- DPM.CopyLocal.targets v' + cCopyLocalTargetsVersion + ' - generated by DPM, do not edit. -->';

//The path goes into a property value, so msbuild's special characters are %-escaped (a '$(' or '@('
//would be expanded, a ';' could split it), then xml's.
function EscapeForTargets(const value : string) : string;
var
  i : integer;
begin
  result := '';
  for i := 1 to Length(value) do
  begin
    case value[i] of
      '%' : result := result + '%25';
      '$' : result := result + '%24';
      '@' : result := result + '%40';
      '''' : result := result + '%27';
      ';' : result := result + '%3B';
      '?' : result := result + '%3F';
      '*' : result := result + '%2A';
      '&' : result := result + '&amp;';
      '<' : result := result + '&lt;';
      '>' : result := result + '&gt;';
      '"' : result := result + '&quot;';
    else
      result := result + value[i];
    end;
  end;
end;

function GetCopyLocalTargetsContent(const dpmExePath : string) : string;
const
  CRLF = #13#10;
begin
  //We hook the build by appending DPMCopyLocal to $(BuildDependsOn) rather than using
  //Target AfterTargets="Build". BeforeTargets/AfterTargets on <Target> require the MSBuild 4.0
  //engine - Delphi XE2..10.2 Tokyo build with FrameworkVersion v3.5 (MSBuild 3.5) which rejects
  //the attribute ("The attribute AfterTargets in element Target is unrecognized"). Appending to
  //$(BuildDependsOn) is the pre-4.0 extension pattern and is non-destructive (additive, never an
  //override) and works on every supported compiler. This relies on the dproj importing this file
  //AFTER CodeGear.Delphi.Targets (TProjectEditor.EnsureCopyLocalImport appends the Import as the
  //last child of <Project>), so $(BuildDependsOn) is already defined when we extend it.
  result :=
    '<?xml version="1.0" encoding="utf-8"?>' + CRLF +
    cVersionMarker + CRLF +
    '<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">' + CRLF +
    '  <PropertyGroup Condition="''$(DPMCopyLocalDisable)'' != ''true''">' + CRLF +
    '    <BuildDependsOn>$(BuildDependsOn);DPMCopyLocal</BuildDependsOn>' + CRLF +
    '  </PropertyGroup>' + CRLF +
    '  <Target Name="DPMCopyLocal">' + CRLF +
    '    <PropertyGroup>' + CRLF +
    //$(OutputPath) is the item transform @(OutputFile->'%(FullPath)') - the exe path, not its
    //folder - so take the directory straight from the OutputFile item metadata. (Item refs are
    //evaluated in a property value, but not inside a property function like GetDirectoryName.)
    '      <_DPMOutputDir>@(OutputFile->''%(RootDir)%(Directory)'')</_DPMOutputDir>' + CRLF +
    '      <_DPMRecordedExe>' + EscapeForTargets(dpmExePath) + '</_DPMRecordedExe>' + CRLF +
    '      <_DPMExe Condition="''$(DPMExe)'' != '''' and Exists(''$(DPMExe)'')">$(DPMExe)</_DPMExe>' + CRLF +
    '      <_DPMExe Condition="''$(_DPMExe)'' == '''' and ''$(_DPMRecordedExe)'' != '''' and Exists(''$(_DPMRecordedExe)'')">$(_DPMRecordedExe)</_DPMExe>' + CRLF +
    '    </PropertyGroup>' + CRLF +
    '    <Warning Condition="''$(_DPMExe)'' == ''''" Text="DPM copy-local was skipped - dpm.exe was not found at [$(_DPMRecordedExe)]. ' +
            'Restore the project with dpm (which records where dpm.exe is on this machine), or pass /p:DPMExe=&lt;full path to dpm.exe&gt; to msbuild." />' + CRLF +
    '    <Exec Condition="''$(_DPMExe)'' != ''''" ContinueOnError="true" Command="&quot;$(_DPMExe)&quot; copylocal &quot;$(MSBuildProjectFullPath)&quot;' +
            ' -platform=$(Platform) -config=$(Config) -outputDir=&quot;$(_DPMOutputDir)&quot;' +
            ' -compiler=$(DPMCompiler) -usePackages=$(UsePackages) -runtimePackages=&quot;$(DCC_UsePackage)&quot;" />' + CRLF +
    '  </Target>' + CRLF +
    '</Project>' + CRLF;
end;

procedure EnsureCopyLocalTargets(const cacheRoot : string; const dpmExePath : string; const logger : ILogger);
var
  targetsFile : string;
  content : string;
  existing : string;
begin
  if cacheRoot = '' then
    exit;
  targetsFile := TPath.Combine(cacheRoot, cCopyLocalTargetsFileName);
  try
    content := GetCopyLocalTargetsContent(dpmExePath);
    if TFile.Exists(targetsFile) then
    begin
      existing := TFile.ReadAllText(targetsFile);
      if existing = content then
        exit;
      //we don't know where dpm.exe is - the one this version recorded is the better guess.
      if (dpmExePath = '') and (Pos(cVersionMarker, existing) > 0) then
        exit;
    end;
    if not TDirectory.Exists(cacheRoot) then
      TDirectory.CreateDirectory(cacheRoot);
    TFile.WriteAllText(targetsFile, content, TEncoding.UTF8);
    logger.Debug('Wrote copy-local targets file [' + targetsFile + '].');
  except
    on e : Exception do
      logger.Warning(TWarningCode.W3016_CopyLocalTargetsWriteFailed, 'Unable to write the copy-local targets file [' + targetsFile + '] : ' + e.Message);
  end;
end;

end.
