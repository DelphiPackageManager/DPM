function HexBytes(const hex : string) : TBytes;
begin
  SetLength(result, Length(hex) div 2);
  HexToBin(PChar(hex), @result[0], Length(result));
end;

function CountFiles(const folder : string) : integer;
begin
  if TDirectory.Exists(folder) then
    result := Length(TDirectory.GetFiles(folder, '*', TSearchOption.soAllDirectories))
  else
    result := 0;
end;

//the current user's CNG keys and legacy CSP RSA key containers.
function KeyContainerCount : integer;
var
  appData : string;
begin
  appData := GetEnvironmentVariable('APPDATA');
  result := CountFiles(TPath.Combine(appData, 'Microsoft\Crypto\Keys')) + CountFiles(TPath.Combine(appData, 'Microsoft\Crypto\RSA'));
end;

{ TPfxSigningTests }

procedure TPfxSigningTests.SigningWithPfx_LeavesNoKeyInTheUserKeyStore;
var
  logger : ILogger;
  hashing : IHashingService;
  x509 : IX509Service;
  cms : ICmsService;
  options : TSignOptions;
  pfxFile : string;
  provider : ISigningProvider;
  content : TBytes;
  signature : TBytes;
  signer : ICertificate;
  attrs : TCmsAttributes;
  before : integer;
  i : integer;
begin
  logger := TTestLogger.Create;
  hashing := TBCryptHashingService.Create;
  x509 := TX509Service.Create(hashing);
  cms := TCmsService.Create(logger, x509, hashing);
  content := TEncoding.UTF8.GetBytes('{"files":[]}');
  SetLength(attrs, 0);
  pfxFile := TPath.Combine(TPath.GetTempPath, 'dpm-test-' + IntToStr(GetCurrentProcessId) + '.pfx');
  TFile.WriteAllBytes(pfxFile, HexBytes(cTestPfxHex));
  options := TSignOptions.Create;
  try
    options.PfxFile := pfxFile;
    options.PfxPassword := cTestPfxPassword;
    before := KeyContainerCount;
    for i := 1 to 2 do
    begin
      provider := TSigningProviderFactory.CreateProvider(logger, x509, options);
      Assert.IsNotNull(provider, 'no provider for the PFX : ' + (logger as TTestLogger).Messages.Text);
      Assert.AreEqual(cTestPfxThumbprint, provider.Certificate.Thumbprint, 'the signing certificate is the one with the key');
      //dpm sign holds the key open for the whole batch - a token driver asks for its PIN once.
      provider.BeginSession;
      try
        signature := cms.Sign(content, provider, attrs, haSha256);
      finally
        provider.EndSession;
      end;
      Assert.IsTrue(cms.VerifyDetached(signature, content, signer), 'a signature made with the PFX key should verify');
      signer := nil;
      provider := nil;
    end;
    Assert.AreEqual(before, KeyContainerCount, 'signing with a PFX left key containers in the user''s key store');
  finally
    options.Free;
    DeleteFile(pfxFile);
  end;
end;

initialization
  TDUnitX.RegisterTestFixture(TPfxSigningTests);

end.
