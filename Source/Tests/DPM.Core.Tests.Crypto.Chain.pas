function LoadCert(const hex : string) : ICertificate;
var
  hashing : IHashingService;
  x509 : IX509Service;
  der : TBytes;
begin
  SetLength(der, Length(hex) div 2);
  HexToBin(PChar(hex), @der[0], Length(der));
  hashing := TBCryptHashingService.Create;
  x509 := TX509Service.Create(hashing);
  result := x509.LoadCertificateFromDer(der);
end;

function NewChain : ICertificateChain;
var
  hashing : IHashingService;
  x509 : IX509Service;
begin
  hashing := TBCryptHashingService.Create;
  x509 := TX509Service.Create(hashing);
  result := x509.CreateChain;
end;

{ TCertificateChainClassificationTests }

procedure TCertificateChainClassificationTests.SelfSigned_EndsOnlyAtUntrustedRoot;
var
  chain : ICertificateChain;
  certs : array of ICertificate;
begin
  chain := NewChain;
  SetLength(certs, 0);
  Assert.AreEqual(Ord(crUntrustedRoot), Ord(chain.BuildAtTime(LoadCert(cSelfSignedCodeSigningHex), certs, EncodeDate(2030, 6, 1), false)));
  Assert.IsTrue(chain.EndsOnlyAtUntrustedRoot, 'a sound self-signed code signing certificate only lacks a trusted root');
end;

procedure TCertificateChainClassificationTests.SelfSigned_PolicyPassesOnlyWhenUntrustedRootAllowed;
var
  chain : ICertificateChain;
  certs : array of ICertificate;
begin
  chain := NewChain;
  SetLength(certs, 0);
  chain.BuildAtTime(LoadCert(cSelfSignedCodeSigningHex), certs, EncodeDate(2030, 6, 1), false);
  Assert.AreEqual(Ord(crUntrustedRoot), Ord(chain.VerifyForCodeSigning(EncodeDate(2030, 6, 1))), 'the base policy rejects an unknown CA');
  Assert.AreEqual(Ord(crValid), Ord(chain.VerifyForCodeSigning(EncodeDate(2030, 6, 1), true)), chain.LastErrorMessage);
  //the leaf validity check still applies with an untrusted root allowed.
  Assert.AreEqual(Ord(crExpired), Ord(chain.VerifyForCodeSigning(EncodeDate(2050, 1, 1), true)));
end;

procedure TCertificateChainClassificationTests.Expired_IsNotOnlyAnUntrustedRoot;
var
  chain : ICertificateChain;
  certs : array of ICertificate;
begin
  chain := NewChain;
  SetLength(certs, 0);
  Assert.AreNotEqual(Ord(crValid), Ord(chain.BuildAtTime(LoadCert(cExpiredCodeSigningHex), certs, EncodeDate(2030, 6, 1), false)));
  Assert.IsFalse(chain.EndsOnlyAtUntrustedRoot, 'an expired certificate is an integrity failure, not just an untrusted root');
end;

procedure TCertificateChainClassificationTests.WrongUsage_IsNotOnlyAnUntrustedRoot;
var
  chain : ICertificateChain;
  certs : array of ICertificate;
begin
  chain := NewChain;
  SetLength(certs, 0);
  chain.BuildAtTime(LoadCert(cServerAuthOnlyHex), certs, EncodeDate(2030, 6, 1), false);
  Assert.IsFalse(chain.EndsOnlyAtUntrustedRoot, 'a certificate without the code signing usage is an integrity failure');
end;

procedure TCertificateChainClassificationTests.TimestampAuthority_SelfSigned_EndsOnlyAtUntrustedRoot;
var
  chain : ICertificateChain;
  certs : array of ICertificate;
begin
  //a timestamp authority this machine doesn't trust - the timestamp is then not relied on, rather than failing.
  chain := NewChain;
  SetLength(certs, 0);
  Assert.AreEqual(Ord(crUntrustedRoot), Ord(chain.BuildAtTimeForUsage(LoadCert(cSelfSignedTimestampingHex), certs, EncodeDate(2030, 6, 1), false,
    szOID_PKIX_KP_TIMESTAMP_SIGNING)));
  Assert.IsTrue(chain.EndsOnlyAtUntrustedRoot, chain.LastErrorMessage);
  Assert.AreEqual(Ord(crValid), Ord(chain.VerifyForCodeSigning(EncodeDate(2030, 6, 1), true)), chain.LastErrorMessage);
end;

procedure TCertificateChainClassificationTests.TimestampAuthority_CodeSigningCertificate_IsWrongUsage;
var
  chain : ICertificateChain;
  certs : array of ICertificate;
begin
  //a code signing certificate can't issue timestamps - built for time stamping it is an integrity failure.
  chain := NewChain;
  SetLength(certs, 0);
  chain.BuildAtTimeForUsage(LoadCert(cSelfSignedCodeSigningHex), certs, EncodeDate(2030, 6, 1), false, szOID_PKIX_KP_TIMESTAMP_SIGNING);
  Assert.IsFalse(chain.EndsOnlyAtUntrustedRoot, 'a certificate without the time stamping usage is an integrity failure');
end;

procedure TCertificateChainClassificationTests.HasEku_RequirePresent;
var
  tsa : ICertificate;
  codeSigning : ICertificate;
begin
  tsa := LoadCert(cSelfSignedTimestampingHex);
  codeSigning := LoadCert(cSelfSignedCodeSigningHex);
  Assert.IsTrue(tsa.HasEku(szOID_PKIX_KP_TIMESTAMP_SIGNING, true));
  Assert.IsFalse(tsa.HasEku(szOID_PKIX_KP_CODE_SIGNING, true));
  Assert.IsFalse(codeSigning.HasEku(szOID_PKIX_KP_TIMESTAMP_SIGNING, true));
  Assert.IsTrue(codeSigning.HasCodeSigningEku);
  Assert.IsFalse(tsa.HasCodeSigningEku);
end;

procedure TCertificateChainClassificationTests.PublicKeyBits_Rsa2048;
begin
  Assert.AreEqual(Ord(cktRsa), Ord(LoadCert(cSelfSignedTimestampingHex).PublicKeyType));
  Assert.AreEqual(2048, LoadCert(cSelfSignedTimestampingHex).PublicKeyBits);
end;

initialization
  TDUnitX.RegisterTestFixture(TCertificateChainClassificationTests);

