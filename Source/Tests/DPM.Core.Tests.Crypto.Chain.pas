    [Test] procedure Expired_IsNotOnlyAnUntrustedRoot;
    [Test] procedure WrongUsage_IsNotOnlyAnUntrustedRoot;
    [Test] procedure TimestampAuthority_SelfSigned_EndsOnlyAtUntrustedRoot;
    [Test] procedure TimestampAuthority_CodeSigningCertificate_IsWrongUsage;
    [Test] procedure HasEku_RequirePresent;
    [Test] procedure PublicKeyBits_Rsa2048;
  end;

