    "if": {
        "properties": {
            "packageKind": {
                "pattern": "^\\s*[Gg][Ii][Tt]\\s*$"
            }
        },
        "required": [
            "packageKind"
        ]
    },
    "else": {
        "properties": {
            "metadata": {
                "required": [
                    "version"
                ]
            }
        }
    },
    "additionalProperties": false
