    "properties": {
        "min dpm client version": {
            "description": "The oldest dpm that can use this spec - an older dpm refuses it.",
            "allOf": [
                {
                    "$ref": "#/definitions/version"
                }
            ]
        },
        "packageKind": {
            "$ref": "#/definitions/packageKind"
        },
        "metadata": {
            "type": "object",
            "description": "Information about the package.",
            "properties": {
                "id": {
                    "$ref": "#/definitions/packageId"
                },
                "version": {
                    "description": "The package version - a semantic version, e.g. 1.2.3. Required unless packageKind is git (a git package's versions come from the repository's tags).",
                    "allOf": [
                        {
                            "$ref": "#/definitions/version"
                        }
                    ]
                },
                "description": {
                    "type": "string",
                    "description": "A brief description of the package.",
                    "minLength": 1
                },
                "authors": {
                    "type": "array",
                    "description": "The authors of the package.",
                    "items": {
                        "type": "string"
                    },
                    "minItems": 1
                },
                "projectUrl": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "The project's home page."
                },
                "repositoryUrl": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "The url of the source repository."
                },
                "repositoryType": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "The type of the source repository - e.g. git."
                },
                "repositoryBranch": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "The repository branch this version was built from."
                },
                "repositoryCommit": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "The commit this version was built from."
                },
                "license": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "The license, as an SPDX license identifier or expression - e.g. Apache-2.0 or MIT."
                },
                "copyright": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "The copyright notice."
                },
                "icon": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "The icon file, relative to the spec."
                },
                "readme": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "The readme file, relative to the spec."
                },
                "releaseNotes": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "Release notes for this version."
                },
                "tags": {
                    "type": [
                        "array",
                        "null"
                    ],
                    "description": "Single word tags to find this package by.",
                    "items": {
                        "type": "string"
                    },
                    "uniqueItems": true
                },
                "frameworks": {
                    "type": [
                        "array",
                        "null"
                    ],
                    "description": "The UI frameworks the package supports.",
                    "items": {
                        "$ref": "#/definitions/framework"
                    },
                    "uniqueItems": true
                },
                "isTrial": {
                    "type": "boolean",
                    "description": "True for a trial version of a commercial package."
                },
                "isCommercial": {
                    "type": "boolean",
                    "description": "True for a commercial package."
                }
            },
            "required": [
                "id",
                "description",
                "authors"
            ],
            "additionalProperties": false
        },
        "variables": {
            "description": "Package-level variables, referenced as $name$ elsewhere in the spec and replaced at pack time. A targetPlatform's variables override them.",
            "allOf": [
