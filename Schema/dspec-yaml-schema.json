{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://raw.githubusercontent.com/DelphiPackageManager/DPM/master/Schema/dspec-yaml-schema.json",
    "title": "DPM package spec (.dspec)",
    "description": "Syntax checking, autocompletion and validation for DPM package spec (.dspec / .dspec.yaml) files.",
    "$comment": "Generated by Schema/generate-dspec-schema.js from the dspec reader (Source/Core/Spec) - edit the generator and rerun it rather than editing this file. Keys are case-sensitive; compiler, platform, framework, packageKind and kind values are not.",
    "type": "object",
    "definitions": {
        "compilerVersion": {
            "description": "A Delphi compiler version - e.g. delphi12.0, 12.0, 12, delphixe2 or XE2 (case does not matter). From Delphi 11 on a point release means its major version - 12.3 is delphi12.0.",
            "anyOf": [
                {
                    "type": "string",
                    "enum": [
                        "delphixe2",
                        "delphixe3",
                        "delphixe4",
                        "delphixe5",
                        "delphixe6",
                        "delphixe7",
                        "delphixe8",
                        "delphi10.0",
                        "delphi10.1",
                        "delphi10.2",
                        "delphi10.3",
                        "delphi10.4",
                        "delphi11.0",
                        "delphi12.0",
                        "delphi13.0"
                    ]
                },
                {
                    "type": "string",
                    "pattern": "^([Dd][Ee][Ll][Pp][Hh][Ii])?([Xx][Ee][2-8](\\.0)?|10(\\.[0-4])?|1[1-3](\\.[0-9]+)*)$"
                },
                {
                    "type": "number",
                    "enum": [
                        10,
                        10.1,
                        10.2,
                        10.3,
                        10.4
                    ]
                },
                {
                    "type": "number",
                    "minimum": 11,
                    "exclusiveMaximum": 14
                }
            ]
        },
        "excludeCompilers": {
            "description": "Compilers to leave this entry out for, even though their targetPlatform uses this template - eg a project that does not exist for an older compiler. Applied at pack time. A list, or a single compiler.",
            "anyOf": [
                {
                    "type": "null"
                },
                {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/compilerVersion"
                    },
                    "uniqueItems": true
                },
                {
                    "$ref": "#/definitions/compilerVersion"
                }
            ]
        },
        "platform": {
            "description": "A DPM platform (case does not matter).",
            "anyOf": [
                {
                    "type": "string",
                    "enum": [
                        "win32",
                        "win64",
                        "win64x",
                        "winarm64ec",
                        "macos32",
                        "macos64",
                        "macosarm64",
                        "android",
                        "android64",
                        "ios32",
                        "ios64",
                        "iossimulator",
                        "iossimarm64",
                        "linux64"
                    ]
                },
                {
                    "type": "string",
                    "pattern": "^\\s*([Ww][Ii][Nn]32|[Ww][Ii][Nn]64|[Ww][Ii][Nn]64[Xx]|[Ww][Ii][Nn][Aa][Rr][Mm]64[Ee][Cc]|[Mm][Aa][Cc][Oo][Ss]32|[Mm][Aa][Cc][Oo][Ss]64|[Mm][Aa][Cc][Oo][Ss][Aa][Rr][Mm]64|[Aa][Nn][Dd][Rr][Oo][Ii][Dd]|[Aa][Nn][Dd][Rr][Oo][Ii][Dd]64|[Ii][Oo][Ss]32|[Ii][Oo][Ss]64|[Ii][Oo][Ss][Ss][Ii][Mm][Uu][Ll][Aa][Tt][Oo][Rr]|[Ii][Oo][Ss][Ss][Ii][Mm][Aa][Rr][Mm]64|[Ll][Ii][Nn][Uu][Xx]64)\\s*$"
                }
            ]
        },
        "designPlatform": {
            "description": "An IDE bitness - design packages load into the IDE, which is only ever Win32 or Win64 (case does not matter).",
            "anyOf": [
                {
                    "type": "string",
                    "enum": [
                        "win32",
                        "win64"
                    ]
                },
                {
                    "type": "string",
                    "pattern": "^\\s*([Ww][Ii][Nn]32|[Ww][Ii][Nn]64)\\s*$"
                }
            ]
        },
        "framework": {
            "description": "A UI framework (case does not matter).",
            "anyOf": [
                {
                    "type": "string",
                    "enum": [
                        "vcl",
                        "fmx"
                    ]
                },
                {
                    "type": "string",
                    "pattern": "^\\s*([Vv][Cc][Ll]|[Ff][Mm][Xx])\\s*$"
                }
            ]
        },
        "packageKind": {
            "description": "dpm (the default) for a package built and published with dpm pack, git for a package installed straight from a git repository (case does not matter).",
            "anyOf": [
                {
                    "type": "string",
                    "enum": [
                        "dpm",
                        "git"
                    ]
                },
                {
                    "type": "string",
                    "pattern": "^\\s*([Dd][Pp][Mm]|[Gg][Ii][Tt])\\s*$"
                }
            ]
        },
        "packageId": {
            "type": "string",
            "description": "A package id in the form Org.PackageName - e.g. VSoft.DUnitX. Letters, digits and underscores, at least three characters before the first dot.",
            "pattern": "^[A-Za-z]\\w{2,}(\\.\\w+)+$",
            "patternErrorMessage": "Not a valid package id - it must be of the form Org.PackageName, e.g. VSoft.DUnitX."
        },
        "version": {
            "description": "A semantic version - major.minor[.patch][-prerelease][+metadata], e.g. 1.2.3 or 2.0.0-beta.1.",
            "anyOf": [
                {
                    "type": "string",
                    "pattern": "^\\s*[0-9]+\\.[0-9]+(\\.[0-9]+)?(-[^+]+)?(\\+.+)?\\s*$",
                    "patternErrorMessage": "Not a valid semantic version - expected major.minor[.patch][-prerelease][+metadata], e.g. 1.2.3."
                },
                {
                    "type": "number"
                }
            ]
        },
        "variables": {
            "type": "object",
            "description": "Variables referenced as $name$ elsewhere in the spec and replaced at pack time. Names are case-insensitive.",
            "additionalProperties": {
                "type": [
                    "string",
                    "number",
                    "boolean"
                ]
            }
        },
        "dependency": {
            "type": "object",
            "properties": {
                "id": {
                    "description": "The id of the package depended on - e.g. VSoft.DUnitX.",
                    "allOf": [
                        {
                            "$ref": "#/definitions/packageId"
                        }
                    ]
                },
                "version": {
                    "type": "string",
                    "description": "The versions accepted. A bare version (1.2.3) is an exact pin. A range may only float the patch: [1.2.3,] or [1.2.3,) is 1.2.3 and any later 1.2.x, [1.2.3,1.2.9] a span within 1.2. $version$ means this package's own version; bundled means a library that ships with the Delphi IDE (e.g. Indy).",
                    "pattern": "^\\s*(?:\\$[Vv][Ee][Rr][Ss][Ii][Oo][Nn]\\$|[Bb][Uu][Nn][Dd][Ll][Ee][Dd]|[0-9]+\\.[0-9]+\\.[0-9]+(?:-[^+]+)?(?:\\+.+)?|[\\[(]\\s*[0-9]+\\.[0-9]+(?:\\.[0-9]+)?(?:-[^+,\\])\\s]+)?(?:\\+[^,\\])\\s]+)?\\s*,\\s*[\\])]|[\\[(]\\s*,\\s*[0-9]+\\.[0-9]+(?:\\.[0-9]+)?(?:-[^+,\\])\\s]+)?(?:\\+[^,\\])\\s]+)?\\s*[\\])]|[\\[(]\\s*([0-9]+)\\.([0-9]+)(?:\\.[0-9]+)?(?:-[^+,\\])\\s]+)?(?:\\+[^,\\])\\s]+)?\\s*,\\s*\\1\\.\\2(?:\\.[0-9]+)?(?:-[^+,\\])\\s]+)?(?:\\+[^,\\])\\s]+)?\\s*[\\])])\\s*$",
                    "patternErrorMessage": "Not a valid dependency version. Use an exact version (1.2.3), a range that only floats the patch ([1.2.3,] or [1.2.3,1.2.9]), $version$ or bundled."
                }
            },
            "required": [
                "id",
                "version"
            ],
            "additionalProperties": false
        },
        "sourceEntry": {
            "type": "object",
            "properties": {
                "src": {
                    "type": "string",
                    "description": "The files to include - an ant pattern, relative to the spec, e.g. .\\source\\**\\*.pas"
                },
                "dest": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "The folder in the package the matched files are placed in."
                },
                "exclude": {
                    "type": [
                        "array",
                        "null"
                    ],
                    "description": "Patterns for files to leave out of the matched files - e.g. *.dcu",
                    "items": {
                        "type": "string"
                    }
                },
                "copyToLib": {
                    "type": "boolean",
                    "description": "When true, the matched files are also copied, flattened, into lib\\{platform} at install time - e.g. dfm or res files."
                },
                "copyToBin": {
                    "description": "Copy the matched files, flattened, into bpl\\{platform} at install time, but only when installing for this platform - used for native dlls a runtime or design bpl needs to load.",
                    "anyOf": [
                        {
                            "type": "null"
                        },
                        {
                            "$ref": "#/definitions/platform"
                        }
                    ]
                }
            },
            "patternProperties": {
                "^copyto[Ll]ib$": {
                    "type": "boolean",
                    "description": "Alternative spelling of copyToLib."
                },
                "^copyto[Bb]in$": {
                    "description": "Alternative spelling of copyToBin.",
                    "anyOf": [
                        {
                            "type": "null"
                        },
                        {
                            "$ref": "#/definitions/platform"
                        }
                    ]
                }
            },
            "required": [
                "src"
            ],
            "additionalProperties": false
        },
        "buildEntry": {
            "type": "object",
            "properties": {
                "project": {
                    "type": "string",
                    "description": "The runtime package project (.dproj or .dpk) to build at install time, as a path in the package."
                },
                "platforms": {
                    "type": [
                        "array",
                        "null"
                    ],
                    "description": "The platforms to build this project for - overrides the targetPlatform's platforms. Omit to use them all.",
                    "items": {
                        "$ref": "#/definitions/platform"
                    },
                    "uniqueItems": true
                },
                "defines": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "Semicolon separated compiler defines - e.g. RELEASE;DPM"
                },
                "references": {
                    "type": [
                        "array",
                        "null"
                    ],
                    "description": "Package names this package requires beyond rtl. Used by dpm prepare for the dpk requires clause and dproj references - not at pack or install time.",
                    "items": {
                        "type": "string"
                    }
                },
                "searchPaths": {
                    "type": [
                        "array",
                        "null"
                    ],
                    "description": "Extra unit search paths, relative to the package root, passed to the compiler when building this project.",
                    "items": {
                        "type": "string"
                    }
                },
                "excludeCompilers": {
                    "$ref": "#/definitions/excludeCompilers"
                }
            },
            "required": [
                "project"
            ],
            "additionalProperties": false
        },
        "designEntry": {
            "type": "object",
            "properties": {
                "project": {
                    "type": "string",
                    "description": "The design package project (.dproj or .dpk) to build at install time, or a prebuilt .bpl the package ships (loaded into the IDE as-is), as a path in the package."
                },
                "platforms": {
                    "type": [
                        "array",
                        "null"
                    ],
                    "description": "The IDE bitnesses this entry is for. For a compiled entry a filter - omit to use the design project's platforms. A prebuilt .bpl entry must name exactly one (one entry per bitness).",
                    "items": {
                        "$ref": "#/definitions/designPlatform"
                    },
                    "uniqueItems": true
                },
                "defines": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "Semicolon separated compiler defines - e.g. DESIGNTIME"
                },
                "references": {
                    "type": [
                        "array",
                        "null"
                    ],
                    "description": "Package names this design package requires beyond rtl and designide. Used by dpm prepare for the dpk requires clause and dproj references - not at pack or install time.",
                    "items": {
                        "type": "string"
                    }
                },
                "searchPaths": {
                    "type": [
                        "array",
                        "null"
                    ],
                    "description": "Extra unit search paths, relative to the package root, passed to the compiler when building this design project.",
                    "items": {
                        "type": "string"
                    }
                },
                "libSuffix": {
                    "type": [
                        "string",
                        "number",
                        "null"
                    ],
                    "description": "The project's LIBSUFFIX, when it is not the default - needed to find the bpl to install. Ignored for a prebuilt .bpl."
                },
                "libPrefix": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "The project's LIBPREFIX, when it is not the default - needed to find the bpl to install. Ignored for a prebuilt .bpl."
                },
                "libVersion": {
                    "type": [
                        "string",
                        "number",
                        "null"
                    ],
                    "description": "The project's LIBVERSION, when it is not the default - needed to find the bpl to install."
                },
                "excludeCompilers": {
                    "$ref": "#/definitions/excludeCompilers"
                }
            },
            "required": [
                "project"
            ],
            "additionalProperties": false
        },
        "packageDefinition": {
            "type": "object",
            "properties": {
                "project": {
                    "type": "string",
                    "description": "Path and name of the dproj to generate - e.g. ./packages/MyLibR.dproj. Must match the build or design entry that compiles it."
                },
                "kind": {
                    "description": "runtime ({$RUNONLY}) or design ({$DESIGNONLY}, adds designide). When omitted, design if requires contains designide, otherwise runtime.",
                    "anyOf": [
                        {
                            "type": "null"
                        },
                        {
                            "type": "string",
                            "enum": [
                                "runtime",
                                "design"
                            ]
                        },
                        {
                            "type": "string",
                            "pattern": "^\\s*([Rr][Uu][Nn][Tt][Ii][Mm][Ee]|[Dd][Ee][Ss][Ii][Gg][Nn])\\s*$"
                        }
                    ]
                },
                "files": {
                    "type": "array",
                    "description": "Ant pattern globs (the same syntax as a source entry's src) for the units to include in the generated package.",
                    "items": {
                        "type": "string"
                    },
                    "minItems": 1
                },
                "exclude": {
                    "type": [
                        "array",
                        "null"
                    ],
                    "description": "Glob patterns, matched against file names, to remove from the matched files.",
                    "items": {
                        "type": "string"
                    }
                },
                "requires": {
                    "type": [
                        "array",
                        "null"
                    ],
                    "description": "Delphi packages to add to the dpk requires clause (e.g. vcl, fmx, sibling runtime packages), without .dcp. rtl is always added; designide is added for design packages.",
                    "items": {
                        "type": "string"
                    }
                },
                "platforms": {
                    "type": [
                        "array",
                        "null"
                    ],
                    "description": "Optional platform override - intersected with the targetPlatform's platforms. Omit to use them all.",
                    "items": {
                        "$ref": "#/definitions/platform"
                    },
                    "uniqueItems": true
                }
            },
            "required": [
                "project",
                "files"
            ],
            "additionalProperties": false
        },
        "copyLocalEntry": {
            "type": "object",
            "properties": {
                "src": {
                    "type": "string",
                    "description": "The files to copy - an ant pattern relative to the package root. May contain $platform$, e.g. bin\\$platform$\\*.dll"
                },
                "platforms": {
                    "type": [
                        "array",
                        "null"
                    ],
                    "description": "The platforms this entry applies to. Omit (or leave empty) for all platforms.",
                    "items": {
                        "$ref": "#/definitions/platform"
                    },
                    "uniqueItems": true
                },
                "mode": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "No longer used and ignored - entries are always copied, and referenced runtime bpls are copied automatically."
                }
            },
            "required": [
                "src"
            ],
            "additionalProperties": false
        },
        "targetPlatform": {
            "type": "object",
            "description": "A set of compilers and the platforms the package supports for them. Use exactly one of compiler, compiler from + compiler to, or compilers. Each compiler may appear in only one targetPlatform.",
            "properties": {
                "compiler": {
                    "description": "A single compiler version.",
                    "allOf": [
                        {
                            "$ref": "#/definitions/compilerVersion"
                        }
                    ]
                },
                "compiler from": {
                    "description": "The first compiler version in a range (inclusive) - use with compiler to.",
                    "allOf": [
                        {
                            "$ref": "#/definitions/compilerVersion"
                        }
                    ]
                },
                "compiler to": {
                    "description": "The last compiler version in a range (inclusive) - use with compiler from.",
                    "allOf": [
                        {
                            "$ref": "#/definitions/compilerVersion"
                        }
                    ]
                },
                "compilers": {
                    "type": "array",
                    "description": "A list of compiler versions.",
                    "items": {
                        "$ref": "#/definitions/compilerVersion"
                    },
                    "minItems": 1,
                    "uniqueItems": true
                },
                "platforms": {
                    "type": "array",
                    "description": "The platforms supported.",
                    "items": {
                        "$ref": "#/definitions/platform"
                    },
                    "minItems": 1,
                    "uniqueItems": true
                },
                "template": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "The name of the template that defines the package for these compilers and platforms - default when omitted."
                },
                "variables": {
                    "description": "Variable overrides for these compilers.",
                    "allOf": [
                        {
                            "$ref": "#/definitions/variables"
                        }
                    ]
                }
            },
            "required": [
                "platforms"
            ],
            "oneOf": [
                {
                    "required": [
                        "compiler"
                    ],
                    "not": {
                        "anyOf": [
                            {
                                "required": [
                                    "compiler from"
                                ]
                            },
                            {
                                "required": [
                                    "compiler to"
                                ]
                            },
                            {
                                "required": [
                                    "compilers"
                                ]
                            }
                        ]
                    }
                },
                {
                    "required": [
                        "compiler from",
                        "compiler to"
                    ],
                    "not": {
                        "anyOf": [
                            {
                                "required": [
                                    "compiler"
                                ]
                            },
                            {
                                "required": [
                                    "compilers"
                                ]
                            }
                        ]
                    }
                },
                {
                    "required": [
                        "compilers"
                    ],
                    "not": {
                        "anyOf": [
                            {
                                "required": [
                                    "compiler"
                                ]
                            },
                            {
                                "required": [
                                    "compiler from"
                                ]
                            },
                            {
                                "required": [
                                    "compiler to"
                                ]
                            }
                        ]
                    }
                }
            ],
            "additionalProperties": false
        },
        "template": {
            "type": "object",
            "description": "A template - what the package contains and how it is built, for the targetPlatforms that name it.",
            "properties": {
                "name": {
                    "type": "string",
                    "description": "The template name, referenced by a targetPlatform's template."
                },
                "dependencies": {
                    "type": [
                        "array",
                        "null"
                    ],
                    "description": "The packages this package depends on. Each id may appear only once.",
                    "items": {
                        "$ref": "#/definitions/dependency"
                    }
                },
                "source": {
                    "type": [
                        "array",
                        "null"
                    ],
                    "description": "The files included in the package.",
                    "items": {
                        "$ref": "#/definitions/sourceEntry"
                    }
                },
                "build": {
                    "type": [
                        "array",
                        "null"
                    ],
                    "description": "Runtime packages built at install time.",
                    "items": {
                        "$ref": "#/definitions/buildEntry"
                    }
                },
                "design": {
                    "type": [
                        "array",
                        "null"
                    ],
                    "description": "Design time packages built (or shipped prebuilt) and installed into the IDE.",
                    "items": {
                        "$ref": "#/definitions/designEntry"
                    }
                },
                "package definitions": {
                    "type": [
                        "array",
                        "null"
                    ],
                    "description": "Package projects (dpk/dproj) to generate for a source-only library that ships none. They are generated into the package cache and compiled at install time. Each definition's project must match the build or design entry that compiles it.",
                    "items": {
                        "$ref": "#/definitions/packageDefinition"
                    }
                },
                "copyLocal": {
                    "type": [
                        "array",
                        "null"
                    ],
                    "description": "Files copied into the consuming project's build output folder at build time (dpm copylocal) - e.g. native dlls. The src is matched against the package cache, so it can name files built during install. Runtime bpls the project links are copied automatically and need no entry.",
                    "items": {
                        "$ref": "#/definitions/copyLocalEntry"
                    }
                },
                "copyToLib": {
                    "type": [
                        "array",
                        "null"
                    ],
                    "description": "Written by dpm pack from the source entries flagged copyToLib (source entries are not kept in a packed spec) - set copyToLib on a source entry instead.",
                    "items": {
                        "$ref": "#/definitions/sourceEntry"
                    }
                },
                "copyToBin": {
                    "type": [
                        "array",
                        "null"
                    ],
                    "description": "Written by dpm pack from the source entries flagged copyToBin (source entries are not kept in a packed spec) - set copyToBin on a source entry instead.",
                    "items": {
                        "$ref": "#/definitions/sourceEntry"
                    }
                },
                "precompiledBinaries": {
                    "type": [
                        "array",
                        "null"
                    ],
                    "description": "Precompiled Windows PE binaries (.bpl/.dll/.exe) the package ships, as archive-relative paths (forward slashes) exactly as they appear in the .dpkg. Written by dpm pack from the files actually added - not normally written by hand. The gallery checks it against the archive: an author-signed package containing an undeclared PE is rejected.",
                    "items": {
                        "type": "string"
                    }
                },
                "environmentVariables": {
                    "type": "object",
                    "description": "Environment variables set in the IDE process while the package's design components are loaded, and cleared or restored when they are unloaded. PATH is appended to (semicolon separated folders), never replaced. Values may use $packageDir$ (the package's cache folder) and $platform$ (the IDE's platform, Win32 or Win64), both resolved at install time.",
                    "propertyNames": {
                        "description": "System, RAD Studio, msbuild and DPM variables can not be set by a package - dpm pack fails.",
                        "not": {
